.env
.env.local
.env.development.local
.env.test.local
.env.production.local

appsettings.Development.json
SCAI/appsettings.Development.json
SCAI/publish/appsettings.Development.json

# VS Code
.vscode/
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/*.instructions.md

# Local History for Visual Studio Code
.history/

# AI Toolkit
.aitk/
